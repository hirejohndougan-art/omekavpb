{
  "name": "visual-page-builder-dev",
  "private": true,
  "description": "Development tooling for the Visual Page Builder and Special Blocks Omeka S modules. Not shipped with the modules.",
  "scripts": {
    "test": "node tests/tools/seed.js && node tests/run.js && php tests/php/run.php && php tests/php/search.php",
    "seed": "node tests/tools/seed.js",
    "lint": "eslint module/VisualPageBuilder/asset/js module/VisualPageBuilder/asset/special-blocks/js module/VisualPageBuilder/asset/menu-builder theme/visual-page-builder-companion/asset/js tests eslint.config.js",
    "lint:php": "php tools/php-cs-fixer.phar check --config=.php-cs-fixer.dist.php module",
    "fix:php": "php tools/php-cs-fixer.phar fix --config=.php-cs-fixer.dist.php module",
    "golden:record": "node tests/tools/golden.js record",
    "golden:compare": "node tests/tools/golden.js compare",
    "package": "bash test-env/package.sh",
    "test:php": "php tests/php/run.php && php tests/php/search.php"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^27.0.0"
  },
  "license": "GPL-2.0-or-later"
}
