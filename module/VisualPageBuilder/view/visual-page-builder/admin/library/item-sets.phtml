<?php
// SPDX-License-Identifier: GPL-2.0-or-later
/**
 * Item sets (Phase 8): cards with counts and a sample image, and a form for a new set.
 *
 * @var array $sets  [id, title, count, sample, itemsUrl]
 * @var string $csrf
 */
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
$csrfName = \VisualPageBuilder\Controller\Admin\LibraryController::CSRF_NAME;
$this->headStyle()->appendStyle('
.vpb-lib-nav{display:flex;flex-wrap:wrap;gap:.4rem;margin:0 0 1rem}
.vpb-lib-nav a{padding:.25rem .7rem;border:1px solid #dfdfdf;border-radius:999px;color:inherit;text-decoration:none;background:#fff}
.vpb-lib-nav a[aria-current=page]{background:#1f4d3f;border-color:#1f4d3f;color:#fff}
.vpb-sets-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(14rem,1fr));gap:.9rem;margin:0 0 1.5rem}
.vpb-set-card{background:#fff;border:1px solid #dfdfdf;border-radius:4px;overflow:hidden;display:flex;flex-direction:column}
.vpb-set-card img{width:100%;aspect-ratio:4/3;object-fit:cover;background:#eee}
.vpb-set-card .vpb-set-body{padding:.6rem .8rem;display:flex;flex-direction:column;gap:.3rem}
.vpb-set-count{color:#676767;font-size:.9rem}
.vpb-set-new{max-width:40rem;background:#fff;border:1px solid #dfdfdf;border-radius:4px;padding:.9rem 1rem}
.vpb-set-new label{display:block;margin:.4rem 0}
.vpb-set-new input[type=text]{width:100%}
');
echo $this->pageTitle($translate('Item sets'), 1, $translate('Visual Builder'));
echo $this->partial('visual-page-builder/admin/library/_nav', ['current' => 'admin/visual-page-builder-item-sets']);
?>
<?php if (!$sets): ?>
<p><?php echo $escape($translate('No item sets yet. Make one below.')); ?></p>
<?php else: ?>
<div class="vpb-sets-grid">
<?php foreach ($sets as $set): ?>
    <section class="vpb-set-card">
        <?php if ($set['sample']): ?><img src="<?php echo $escape($set['sample']); ?>" alt=""><?php endif; ?>
        <div class="vpb-set-body">
            <strong><?php echo $escape($set['title'] !== '' ? $set['title'] : $translate('Untitled')); ?></strong>
            <span class="vpb-set-count"><?php echo $escape(sprintf($translate('%s items'), number_format($set['count']))); ?></span>
            <a href="<?php echo $escape($set['itemsUrl']); ?>"><?php echo $escape($translate('See its items')); ?></a>
        </div>
    </section>
<?php endforeach; ?>
</div>
<?php endif; ?>

<section class="vpb-set-new" aria-labelledby="vpb-new-set">
    <h2 id="vpb-new-set"><?php echo $escape($translate('New item set')); ?></h2>
    <form method="post">
        <input type="hidden" name="<?php echo $escape($csrfName); ?>" value="<?php echo $escape($csrf); ?>">
        <label><?php echo $escape($translate('Name')); ?><input type="text" name="title" required></label>
        <label><?php echo $escape($translate('Description')); ?><textarea name="description" rows="3"></textarea></label>
        <label><input type="checkbox" name="is_public" value="1" checked> <?php echo $escape($translate('Public (visitors can see it)')); ?></label>
        <button type="submit"><?php echo $escape($translate('Make item set')); ?></button>
    </form>
</section>
