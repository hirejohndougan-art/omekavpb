<script>
(function () {
    var form = document.getElementById('vpb-styles-form'), root = document.getElementById('vpb-style-preview');
    if (!form || !root) { return; }
    var sizes = <?php echo json_encode(\VisualPageBuilder\Templates\GlobalStyles::SIZES); ?>;
    var corners = <?php echo json_encode(\VisualPageBuilder\Templates\GlobalStyles::CORNERS); ?>;
    var fonts = <?php echo json_encode(\VisualPageBuilder\Templates\GlobalStyles::FONTS); ?>;
    function val(name) { var el = document.getElementById('vpb-style-' + name); return el ? el.value : ''; }
    function isColor(v) { return /^#[0-9a-fA-F]{6}$/.test(v); }
    function set(prop, v) { if (v !== null && v !== undefined && v !== '') { root.style.setProperty(prop, v); } }
    // Mirrors GlobalStyles::previewStyle: invalid or blank values keep what the page started with.
    function update() {
        var accent = val('accent_color');
        if (isColor(accent)) { set('--pb-accent', accent); }
        if (isColor(val('secondary_color'))) { set('--pb-secondary', val('secondary_color')); }
        if (isColor(val('text_color'))) { set('--pb-ink', val('text_color')); }
        if (isColor(val('background_color'))) { set('--pb-bg', val('background_color')); }
        var link = val('link_color');
        if (isColor(link)) { set('--pb-link', link); } else if (isColor(accent)) { set('--pb-link', accent); }
        set('--pb-text-size', sizes[val('text_size')]);
        set('--pb-radius', corners[val('corner_style')]);
        set('--pb-heading-font', fonts[val('heading_font')]);
        set('--pb-body-font', fonts[val('body_font')]);
    }
    form.addEventListener('input', update);
    form.addEventListener('change', update);
})();
// Display conditions: add/remove rows.
(function () {
    var screenOptions = <?php echo json_encode(array_map(function ($sk) use ($translate) {
        return ['value' => 'screen:' . $sk, 'label' => \VisualPageBuilder\Templates\Screens::label($sk) . ' screen'];
    }, \VisualPageBuilder\Templates\Screens::keys())); ?>;
    function newRow(container) {
        var idx = container.querySelectorAll('.vpb-cond-row').length;
        var row = document.createElement('div');
        row.className = 'vpb-cond-row';
        var opts = '<option value="entire_site"><?php echo addslashes($translate('Entire site')); ?></option>'
            + '<option value="home"><?php echo addslashes($translate('Home page')); ?></option>';
        screenOptions.forEach(function (s) {
            opts += '<option value="' + s.value + '">' + s.label + '</option>';
        });
        opts += '<option value="resource_template"><?php echo addslashes($translate('Resource template')); ?></option>'
            + '<option value="item_set"><?php echo addslashes($translate('Item set')); ?></option>'
            + '<option value="resource_class"><?php echo addslashes($translate('Resource class')); ?></option>';
        row.innerHTML = '<select name="condition_mode[' + idx + ']"><option value="include"><?php echo addslashes($translate('Include')); ?></option><option value="exclude"><?php echo addslashes($translate('Exclude')); ?></option></select>'
            + ' <select name="condition_rule[' + idx + ']">' + opts + '</select>'
            + ' <input type="text" name="condition_value[' + idx + ']" placeholder="<?php echo addslashes($translate('id (if needed)')); ?>" size="8">'
            + ' <button type="button" class="vpb-cond-remove" aria-label="<?php echo addslashes($translate('Remove condition')); ?>">&times;</button>';
        container.appendChild(row);
    }
    document.addEventListener('click', function (e) {
        if (e.target.classList.contains('vpb-cond-add')) {
            var tid = e.target.dataset.template;
            var container = document.querySelector('.vpb-cond-rows[data-template="' + tid + '"]');
            if (container) { newRow(container); }
        }
        if (e.target.classList.contains('vpb-cond-remove')) {
            e.target.closest('.vpb-cond-row').remove();
        }
    });
})();
</script>
</div>
