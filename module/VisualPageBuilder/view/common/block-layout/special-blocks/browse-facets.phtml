<?php
/**
 * Filters for the results, with the filters in use.
 *
 * @var bool $show
 * @var array $groups  [{label, bars, options: [{id, label, count, active, url, bar}]}]
 * @var array $active  [{label, url}] the filters in use; each link removes one
 * @var string|null $clearUrl
 * @var string $panelId
 * @var int $total
 * @var string $blockClass
 * @var bool $showYears  the Years form is shown with the Date setting
 */
if (!$show) {
    return;
}
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
?>
<button type="button" class="vpb-filters-toggle" aria-expanded="false" aria-controls="<?php echo $escape($panelId); ?>"><?php echo $escape($translate('Filters')); ?></button>
<div class="special-blocks <?php echo $escape($blockClass); ?> vpb-facets" id="<?php echo $escape($panelId); ?>" tabindex="-1">
<?php if ($active): ?>
    <div class="vpb-facets-active">
        <p class="vpb-facets-heading"><?php echo $escape($translate('Filtered by')); ?></p>
        <ul>
        <?php foreach ($active as $filter): ?>
            <li><a href="<?php echo $escape($filter['url']); ?>" aria-label="<?php echo $escape(sprintf($translate('Remove %s'), $filter['label'])); ?>"><?php echo $escape($filter['label']); ?> &times;</a></li>
        <?php endforeach; ?>
        </ul>
        <a class="vpb-facets-clear" href="<?php echo $escape($clearUrl); ?>"><?php echo $escape($translate('Clear all filters')); ?></a>
    </div>
<?php endif; ?>
<?php foreach ($groups as $group): ?>
    <fieldset class="vpb-facet">
        <legend><?php echo $escape($group['label']); ?></legend>
        <?php if (!empty($group['letters'])): ?>
        <p class="vpb-facet-letters">
        <?php foreach ($group['letters'] as $letter): ?>
            <a href="<?php echo $escape($letter['url']); ?>" aria-pressed="<?php echo $letter['active'] ? 'true' : 'false'; ?>"><?php echo $escape($letter['letter']); ?></a>
        <?php endforeach; ?>
        </p>
        <?php endif; ?>
        <?php if (!empty($group['dropdown'])): ?>
        <form method="get" action="<?php echo $escape($group['dropdown']['action']); ?>" class="vpb-facet-select">
            <?php foreach ($group['dropdown']['hidden'] as $pair): ?>
            <input type="hidden" name="<?php echo $escape($pair[0]); ?>" value="<?php echo $escape($pair[1]); ?>">
            <?php endforeach; ?>
            <label class="vpb-visually-hidden"><?php echo $escape($group['label']); ?></label>
            <select name="<?php echo $escape($group['dropdown']['name']); ?>">
                <option value=""><?php echo $escape($translate('Choose…')); ?></option>
                <?php foreach ($group['dropdown']['choices'] as $choice): ?>
                <option value="<?php echo (int) $choice['id']; ?>"><?php echo $escape($choice['label']); ?> (<?php echo $escape(number_format($choice['count'])); ?>)</option>
                <?php endforeach; ?>
            </select>
            <button type="submit"><?php echo $escape($translate('Add')); ?></button>
        </form>
        <?php endif; ?>
        <ul>
        <?php foreach ($group['options'] as $option): ?>
            <li<?php if (isset($option['depth']) && $option['depth'] > 0): ?> style="padding-left: <?php echo (float) $option['depth'] * 1.1; ?>rem"<?php endif; ?>>
                <?php if (!empty($option['url'])): ?>
                <a href="<?php echo $escape($option['url']); ?>" aria-pressed="<?php echo $option['active'] ? 'true' : 'false'; ?>">
                    <?php if ($group['bars']): ?><span class="vpb-facet-bar" aria-hidden="true" style="width: <?php echo (int) $option['bar']; ?>%"></span><?php endif; ?>
                    <span class="vpb-facet-label"><?php echo $escape($option['label']); ?></span>
                    <span class="vpb-facet-count"><?php echo $escape(number_format($option['count'])); ?></span>
                </a>
                <?php else: ?>
                <span class="vpb-facet-parent"><span class="vpb-facet-label"><?php echo $escape($option['label']); ?></span></span>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
        </ul>
        <?php if (!empty($group['toggle'])): ?>
        <p class="vpb-facet-more"><a href="<?php echo $escape($group['toggle']['url']); ?>"><?php echo $escape($group['toggle']['label']); ?></a></p>
        <?php endif; ?>
    </fieldset>
<?php endforeach; ?>
<?php if ($showYears): ?>
    <fieldset class="vpb-facet vpb-facet-years">
        <legend><?php echo $escape($translate('Years')); ?></legend>
        <form method="get" action="<?php echo $escape($years['action']); ?>" class="vpb-years-form">
            <?php foreach ($years['hidden'] as $pair): ?>
            <input type="hidden" name="<?php echo $escape($pair[0]); ?>" value="<?php echo $escape($pair[1]); ?>">
            <?php endforeach; ?>
            <label>
                <span><?php echo $escape($translate('From')); ?></span>
                <input type="number" name="year_from" min="0" max="9999" step="1" value="<?php echo $escape($years['from']); ?>">
            </label>
            <label>
                <span><?php echo $escape($translate('To')); ?></span>
                <input type="number" name="year_to" min="0" max="9999" step="1" value="<?php echo $escape($years['to']); ?>">
            </label>
            <button type="submit"><?php echo $escape($translate('Apply years')); ?></button>
        </form>
    </fieldset>
<?php endif; ?>
    <button type="button" class="vpb-facets-done"><?php echo $escape(sprintf($translate('Show %s results'), number_format($total))); ?></button>
</div>
