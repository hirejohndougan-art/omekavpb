<?php
/**
 * Filters for the results, with the filters in use.
 *
 * @var bool $show
 * @var array $groups  [{label, bars, options: [{id, label, count, active, url, bar}]}]
 * @var array $active  [{label, url}] the filters in use; each link removes one
 * @var string|null $clearUrl
 * @var string $panelId
 * @var int $total
 * @var string $blockClass
 */
if (!$show) {
    return;
}
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
?>
<button type="button" class="vpb-filters-toggle" aria-expanded="false" aria-controls="<?php echo $escape($panelId); ?>"><?php echo $escape($translate('Filters')); ?></button>
<div class="special-blocks <?php echo $escape($blockClass); ?> vpb-facets" id="<?php echo $escape($panelId); ?>" tabindex="-1">
<?php if ($active): ?>
    <div class="vpb-facets-active">
        <p class="vpb-facets-heading"><?php echo $escape($translate('Filtered by')); ?></p>
        <ul>
        <?php foreach ($active as $filter): ?>
            <li><a href="<?php echo $escape($filter['url']); ?>" aria-label="<?php echo $escape(sprintf($translate('Remove %s'), $filter['label'])); ?>"><?php echo $escape($filter['label']); ?> &times;</a></li>
        <?php endforeach; ?>
        </ul>
        <a class="vpb-facets-clear" href="<?php echo $escape($clearUrl); ?>"><?php echo $escape($translate('Clear all filters')); ?></a>
    </div>
<?php endif; ?>
<?php foreach ($groups as $group): ?>
    <fieldset class="vpb-facet">
        <legend><?php echo $escape($group['label']); ?></legend>
        <?php if (!empty($group['letters'])): ?>
        <p class="vpb-facet-letters">
        <?php foreach ($group['letters'] as $letter): ?>
            <a href="<?php echo $escape($letter['url']); ?>" aria-pressed="<?php echo $letter['active'] ? 'true' : 'false'; ?>"><?php echo $escape($letter['letter']); ?></a>
        <?php endforeach; ?>
        </p>
        <?php endif; ?>
        <ul>
        <?php foreach ($group['options'] as $option): ?>
            <li>
                <a href="<?php echo $escape($option['url']); ?>" aria-pressed="<?php echo $option['active'] ? 'true' : 'false'; ?>">
                    <?php if ($group['bars']): ?><span class="vpb-facet-bar" aria-hidden="true" style="width: <?php echo (int) $option['bar']; ?>%"></span><?php endif; ?>
                    <span class="vpb-facet-label"><?php echo $escape($option['label']); ?></span>
                    <span class="vpb-facet-count"><?php echo $escape(number_format($option['count'])); ?></span>
                </a>
            </li>
        <?php endforeach; ?>
        </ul>
        <?php if (!empty($group['toggle'])): ?>
        <p class="vpb-facet-more"><a href="<?php echo $escape($group['toggle']['url']); ?>"><?php echo $escape($group['toggle']['label']); ?></a></p>
        <?php endif; ?>
    </fieldset>
<?php endforeach; ?>
    <button type="button" class="vpb-facets-done"><?php echo $escape(sprintf($translate('Show %s results'), number_format($total))); ?></button>
</div>
