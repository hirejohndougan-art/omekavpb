/**
 * The site menu in a header or footer. Same markup and classes as the
 * Companion Theme's own menu (its view/common/vpb-menu.phtml), so the theme's
 * styles and asset/js/theme.js make the drop-downs and phone button work.
 * "list" draws all links as a plain nested list (footer site maps).
 *
 * @var array $data
 * @var string $style a Menu page style (MenuController::STYLES), or list
 * @var \Laminas\Navigation\Navigation $container
 * @var string $navVars    the Menu page's colors (CSS custom properties)
 * @var string $navClasses which colors are set
 * @var string $menuId
 */
$escape = $this->plugin('escapeHtml');
$maxDepth = ['bar' => 1, 'dropdown' => 2, 'centered' => 2, 'mega' => 3, 'sidebar' => 3, 'sidebar-right' => 3, 'vertical-list' => 3, 'vertical-flyout' => 3, 'vertical-boxed' => 3, 'list' => 2][$style] ?? 2;
$counter = 0;
$view = $this;
$list = $style === 'list';
$renderList = function ($pages, int $depth) use (&$renderList, $escape, $maxDepth, &$counter, $view, $menuId, $list) {
    $html = '';
    foreach ($pages as $page) {
        if (!$page->isVisible()) {
            continue;
        }
        $label = (string) $page->getLabel();
        $children = $depth < $maxDepth && $page->hasPages() ? $page->getPages() : [];
        $id = $menuId . '-sub-' . (++$counter);
        $html .= '<li class="pb-item' . ($children ? ' has-sub' : '') . ($page->isActive(true) ? ' is-active' : '') . '">';
        $html .= sprintf('<a href="%s"%s>%s</a>', $escape($page->getHref()), $page->isActive(false) ? ' aria-current="page"' : '', $escape($label));
        if ($children) {
            if (!$list) {
                $html .= sprintf('<button type="button" class="pb-sub-toggle" aria-expanded="false" aria-controls="%s"><span class="pb-visually-hidden">%s</span></button>', $id, $escape(sprintf($view->translate('Show pages under %s'), $label)));
            }
            $html .= sprintf('<ul class="pb-sub pb-level-%d" id="%s">%s</ul>', $depth + 1, $id, $renderList($children, $depth + 1));
        }
        $html .= '</li>';
    }
    return $html;
};
?>
<div class="special-blocks special-blocks-site-menu special-blocks-align-<?php echo $escape($data['align']); ?>">
<?php if ($data['heading'] !== ''): ?><h2 class="special-blocks-menu-heading"><?php echo $escape($data['heading']); ?></h2><?php endif; ?>
<nav class="pb-nav pb-nav-<?php echo $escape($style); ?> <?php echo $escape($navClasses); ?>"<?php echo $navVars !== '' ? ' style="' . $escape($navVars) . '"' : ''; ?> aria-label="<?php echo $escape($data['heading'] !== '' ? $data['heading'] : $this->translate('Main menu')); ?>">
    <?php if (!$list): ?><button type="button" class="pb-nav-toggle" aria-expanded="false" aria-controls="<?php echo $escape($menuId); ?>"><span aria-hidden="true">&#9776;</span> <?php echo $escape($this->translate('Menu')); ?></button><?php endif; ?>
    <ul class="pb-menu pb-level-1" id="<?php echo $escape($menuId); ?>"><?php echo $renderList($container, 1); ?></ul>
</nav>
</div>
