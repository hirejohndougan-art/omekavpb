/**
 * The description.
 * Outside a Theme Builder template it draws nothing; in the editor's preview
 * it shows its sample.
 *
 * @var array $data
 * @var \Omeka\Api\Representation\ItemRepresentation|null $item
 * @var bool $isPreview
 * @var string $sample
 */
$escape = $this->plugin('escapeHtml');
if (!$item) {
    if ($isPreview) {
        echo '<p class="special-blocks-item-sample">' . $escape($sample) . '</p>';
    }
    return;
}
?>
<?php foreach ($paragraphs as $p): ?>
<p class="special-blocks-item-description"><?php echo nl2br($escape($p)); ?></p>
<?php endforeach; ?>
