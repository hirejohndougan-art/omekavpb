/**
 * The item title.
 * Outside a Theme Builder template it draws nothing; in the editor's preview
 * it shows its sample.
 *
 * @var array $data
 * @var \Omeka\Api\Representation\ItemRepresentation|null $item
 * @var bool $isPreview
 * @var string $sample
 */
$escape = $this->plugin('escapeHtml');
$title = $title ?? '';
if (!$item) {
    if ($isPreview) {
        echo '<p class="special-blocks-item-sample">' . $escape($sample) . '</p>';
    }
    return;
}
?>
<?php
$tag = in_array($data['tag'], ['h1', 'h2', 'h3'], true) ? $data['tag'] : 'h1';
?>
<<?php echo $tag; ?> class="special-blocks-item-title"><?php echo $escape($title); ?></<?php echo $tag; ?>>
