/**
 * The item sets (collections) the item is in.
 * Outside a Theme Builder template it draws nothing; in the editor's preview
 * it shows its sample.
 *
 * @var array $data
 * @var \Omeka\Api\Representation\ItemRepresentation|null $item
 * @var bool $isPreview
 * @var string $sample
 */
$escape = $this->plugin('escapeHtml');
if (!$item) {
    if ($isPreview) {
        echo '<p class="special-blocks-item-sample">' . $escape($sample) . '</p>';
    }
    return;
}
?>
<?php if ($sets): ?>
<ul class="special-blocks-item-sets">
<?php foreach ($sets as $set): ?>
    <li><a href="<?php echo $escape($set['url']); ?>"><?php echo $escape($set['title']); ?></a></li>
<?php endforeach; ?>
</ul>
<?php endif; ?>
