/**
 * Subjects as tags, each linked to its browse page.
 * Outside a Theme Builder template it draws nothing; in the editor's preview
 * it shows its sample.
 *
 * @var array $data
 * @var \Omeka\Api\Representation\ItemRepresentation|null $item
 * @var bool $isPreview
 * @var string $sample
 */
$escape = $this->plugin('escapeHtml');
if (!$item) {
    if ($isPreview) {
        echo '<p class="special-blocks-item-sample">' . $escape($sample) . '</p>';
    }
    return;
}
?>
<?php if ($tags): ?>
<ul class="special-blocks-item-tags">
<?php foreach ($tags as $tag): ?>
    <li><?php if ($tag['url']): ?><a href="<?php echo $escape($tag['url']); ?>"><?php echo $escape($tag['text']); ?></a><?php else: ?><?php echo $escape($tag['text']); ?><?php endif; ?></li>
<?php endforeach; ?>
</ul>
<?php endif; ?>
