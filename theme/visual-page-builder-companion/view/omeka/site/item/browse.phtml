/**
 * The item browse page, an item set's page (Omeka shows an item set's items with
 * this view), and a search. When a live Theme Builder template applies, it is
 * drawn: Item set for an item set's page; Search results when the site's search
 * box was used (falling back to Browse items); Browse items otherwise. Otherwise
 * this is Omeka's own page, unchanged.
 */
$helpers = $this->getHelperPluginManager();
$site = $this->currentSite();
$searching = trim((string) $this->params()->fromQuery('fulltext_search', '')) !== '';

$templated = null;
if (isset($itemSet)) {
    $templated = $helpers->has('vpbScreen') ? $this->vpbScreen($site, 'item-set', $itemSet) : null;
} else {
    if ($searching && $helpers->has('vpbScreen')) {
        $templated = $this->vpbScreen($site, 'search-results');
    }
    if ($templated === null && $helpers->has('vpbScreen')) {
        $templated = $this->vpbScreen($site, 'browse-items');
    }
}

if ($templated !== null) {
    echo $templated;
} else {
    // Omeka's own browse page, drawn by Omeka's file (this theme doesn't replace it).
    include OMEKA_PATH . '/application/view/omeka/site/item/browse.phtml';
}
