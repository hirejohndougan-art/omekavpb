/**
 * The item browse page. When a live Theme Builder template applies (Browse
 * items), that template is drawn; otherwise this is Omeka's own browse page,
 * unchanged. Item set pages keep Omeka's layout for now.
 */
$templated = (!isset($itemSet) && $this->getHelperPluginManager()->has('vpbScreen'))
    ? $this->vpbScreen($this->currentSite(), 'browse-items')
    : null;

if ($templated !== null) {
    echo $templated;
} else {
    // Omeka's own browse page, drawn by Omeka's file (this theme doesn't replace it).
    include OMEKA_PATH . '/application/view/omeka/site/item/browse.phtml';
}
