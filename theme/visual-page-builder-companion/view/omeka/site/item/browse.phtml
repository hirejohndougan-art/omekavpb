/**
 * The item browse page, and an item set's page (Omeka shows an item set's items
 * with this view). When a live Theme Builder template applies, it is drawn:
 * Item set for an item set's page, Browse items otherwise. Otherwise this is
 * Omeka's own page, unchanged.
 */
if (isset($itemSet)) {
    $templated = $this->getHelperPluginManager()->has('vpbScreen')
        ? $this->vpbScreen($this->currentSite(), 'item-set', $itemSet)
        : null;
} else {
    $templated = $this->getHelperPluginManager()->has('vpbScreen')
        ? $this->vpbScreen($this->currentSite(), 'browse-items')
        : null;
}

if ($templated !== null) {
    echo $templated;
} else {
    // Omeka's own browse page, drawn by Omeka's file (this theme doesn't replace it).
    include OMEKA_PATH . '/application/view/omeka/site/item/browse.phtml';
}
